{
  "manifest_version": 3,
  "name": "Inmovya WA Auto-Sender",
  "version": "1.0",
  "description": "Clica automaticamente no botao de enviar do WhatsApp Web para campanhas automatizadas do Inmovya.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "*://*.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
