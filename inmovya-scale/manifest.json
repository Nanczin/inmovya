{
    "manifest_version":  3,
    "name":  "Inmovya Scale",
    "short_name":  "Inmovya Scale",
    "version":  "1.0.0",
    "description":  "Ferramentas de produtividade e respostas rápidas para WhatsApp Web.",
    "permissions":  [
                        "storage",
                        "declarativeContent",
                        "unlimitedStorage"
                    ],
    "host_permissions":  [
                             "https://web.whatsapp.com/*"
                         ],
    "action":  {
                   "default_popup":  "popup/popup.html",
                   "default_title":  "Abrir Inmovya Scale"
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://web.whatsapp.com/*"
                                            ],
                                "css":  [
                                            "styles/content.css"
                                        ],
                                "js":  [
                                           "utils/constants.js",
                                           "utils/helpers.js",
                                           "utils/storage.js",
                                           "content/variables.js",
                                           "content/whatsapp-dom.js",
                                           "content/shortcuts.js",
                                           "content/panel.js",
                                           "content/observer.js",
                                           "content/content.js",
                                           "content/scraper.js"
                                       ],
                                "run_at":  "document_end"
                            }
                        ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "web_accessible_resources":  [
                                     {
                                         "matches":  [
                                                         "https://web.whatsapp.com/*"
                                                     ],
                                         "resources":  [
                                                           "popup/*",
                                                           "styles/*"
                                                       ]
                                     }
                                 ]
}
