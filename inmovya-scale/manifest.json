{
    "manifest_version":  3,
    "name":  "Inmovya Scale",
    "short_name":  "Inmovya Scale",
    "version": "1.2.4",
    "description":  "Ferramentas de produtividade e respostas rápidas para WhatsApp Web.",
    "icons":  {
                  "16":  "icons/icon16.png",
                  "32":  "icons/icon32.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "permissions":  [
                        "storage",
                        "declarativeContent",
                        "unlimitedStorage",
                        "nativeMessaging",
                        "tabs"
                    ],
    "host_permissions":  [
                             "https://web.whatsapp.com/*"
                             ,"https://inmovya-main.vercel.app/*"
                         ],
    "web_accessible_resources":  [
                                      {
                                          "resources":  [
                                                            "icons/inmovya-logo.png"
                                                        ],
                                          "matches":  [
                                                          "https://web.whatsapp.com/*"
                                                      ]
                                      }
                                  ],
    "action":  {
                   "default_title":  "Abrir Inmovya Scale",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "32":  "icons/icon32.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://web.whatsapp.com/*"
                                            ],
                                "css":  [
                                            "styles/content.css"
                                        ],
                                "js":  [
                                           "utils/constants.js",
                                           "utils/helpers.js",
                                           "utils/storage.js",
                                           "content/variables.js",
                                           "content/whatsapp-dom.js",
                                           "content/settings-ui.js",
                                           "content/panel.js",
                                           "content/observer.js",
                                           "content/content.js",
                                           "content/scraper.js"
                                       ],
                                "run_at":  "document_end"
                            }
                            ,
                            {
                                "matches": [
                                    "https://inmovya-main.vercel.app/*"
                                ],
                                "js": [
                                    "content/campaign-bridge.js"
                                ],
                                "run_at": "document_start"
                            }
                        ],
    "background":  {
                       "service_worker":  "background.js"
                   }
}
